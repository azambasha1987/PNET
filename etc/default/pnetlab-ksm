# PNetLab KSM tuning — consumed by pnetlab-ksm.service / pnetlab-ksm-tune.sh.
#
# KSM_MODE=static (default): fixed high scan rate. Benchmarked on the noble 6.12
# KSM kernel to merge ~1.6 GB across 8 idle vIOS and converge in ~30s. This is
# the UKSM-class replacement and what we ship.
# KSM_MODE=advisor: kernel self-throttles scan rate to a target full-scan time
# (lower CPU when idle, but converges far slower — ~0.2 GB in the same window).
KSM_MODE=static
# static mode: pages per scan cycle / ms between cycles.
KSM_PAGES_TO_SCAN=2000
KSM_SLEEP_MS=20
# advisor mode only: target full-scan seconds + CPU cap (% of one core).
KSM_TARGET_SCAN_TIME=60
KSM_MAX_CPU=
# both modes:
KSM_SMART_SCAN=1
KSM_USE_ZERO_PAGES=1
KSM_RUN=1
